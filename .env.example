# Messages from the contact form are delivered with Resend (resend.com).
# Free tier covers 3,000 emails a month.
#
#   1. Sign up at https://resend.com with somrat.info.ict@gmail.com
#   2. API Keys -> Create API Key (sending access is enough)
#   3. Paste it below, and add the same value in Vercel

RESEND_API_KEY=re_your_api_key_here

# Where contact-form messages are delivered.
CONTACT_TO=somrat.info.ict@gmail.com

# Optional. Until a domain is verified in Resend, leave this unset: the shared
# onboarding@resend.dev sender is used, which can only deliver to the address
# that owns the Resend account. Once a domain is verified, set it to something
# like "Portfolio <hello@fazlarabbisomrat.com>".
# RESEND_FROM=
