# SMTP credentials used by /api/contact to deliver messages.
# Gmail: turn on 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and paste it below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=somrat.info.ict@gmail.com
SMTP_PASS=your-16-character-app-password

# Where contact-form messages are delivered.
CONTACT_TO=somrat.info.ict@gmail.com
